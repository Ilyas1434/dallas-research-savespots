# Copy this file to .env and fill in real values. Never commit .env itself
# (it's already in .gitignore).

# Required by scripts/build_context.py (Census ACS 5-year subject tables).
# Get a free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# Optional fallback geocoder used by scripts/build_naloxone.py and
# scripts/build_candidates.py when the free Census geocoder can't match an
# address. Both scripts run fine without this key (they just skip the
# fallback and log a note) -- currently 0 records need it.
# Get a key: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=
