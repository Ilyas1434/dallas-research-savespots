    "walk_radius_m": 805.0,
    "projection": "EPSG:32138",
    "block_distance_column_used": "dist_supply_m",
    "block_distance_column_note": "block_access.csv has no literal 'dist_nearest_any_m'; the spec's 'distance to nearest any supply' is dist_supply_m (verified: dist_supply_m<=1609.344 matches within_1mi_supply exactly, and its pop-weighted tract mean tracks composite raw_dist_nearest_any_m)."
